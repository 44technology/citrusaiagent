# ============================================================
#  Citrus AI — Production Environment Variables
#  Copy this file to .env and fill in your real values
#  NEVER commit the .env file to git
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Keep using Render PostgreSQL OR paste a new Neon/other DB URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/citrus_db

# ── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── File Uploads ─────────────────────────────────────────────
# Persistent directory on the VPS — must exist and be writable
UPLOADS_DIR=/var/uploads/citrus

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_password

# ── App URL ──────────────────────────────────────────────────
BASE_URL=https://your-domain.com

# ── Optional: Bland AI (AI calling feature) ──────────────────
# BLAND_API_KEY=your_bland_api_key
