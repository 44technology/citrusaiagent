generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id         String     @id @default(uuid())
  name       String
  phone      String
  email      String     @default("N/A")
  company    String     @default("N/A")
  department String     @default("N/A")
  language   String     @default("English")
  credit     Float      @default(0)
  status     String     @default("Pending")
  type       String     @default("Lead")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  calls      CallLog[]
  notes      Note[]
  shipments  Shipment[]
  orders     Order[]
  users      User[]
  purchaseOrders PurchaseOrder[]
}

model Note {
  id        String   @id @default(uuid())
  text      String
  isSystem  Boolean  @default(false)
  contactId String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model CallLog {
  id          String   @id @default(uuid())
  blandCallId String?
  status      String
  duration    Int?
  transcript  String?
  summary     String?
  contactId   String
  createdAt   DateTime @default(now())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Shipment {
  id              String    @id @default(uuid())
  label           String
  destination     String
  vesselName      String?
  containerNumber String?
  bolNumber       String?
  vesselEta       DateTime?
  vesselDeparture DateTime?
  vesselArrival   DateTime?
  shippingLine    String?
  status          String    @default("Pending")
  notes           String?
  contactId       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  origin          String?
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("user")
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String   @id @default(uuid())
  referenceId String
  shipper     String
  product     String
  label       String
  variety     String
  boxType     String
  boxQuantity Int
  receiver    String
  week        String
  status      String   @default("pending")
  userId      String?
  contactId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  invoices    Invoice[]
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  poNumber    String   @unique
  orderId     String
  supplierId  String
  totalAmount Float    @default(0)
  status      String   @default("Draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id])
  supplier    Contact  @relation(fields: [supplierId], references: [id])
  invoices    Invoice[]
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  type          String   // "Sales" or "Purchase"
  amount        Float
  status        String   @default("Unpaid")
  issueDate     DateTime @default(now())
  dueDate       DateTime?
  orderId       String?
  poId          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order?   @relation(fields: [orderId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id])
}
