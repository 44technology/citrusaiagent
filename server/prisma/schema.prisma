generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  color     String   @default("#ff6b00")
  createdAt DateTime @default(now())

  contacts       Contact[]
  orders         Order[]
  shipments      Shipment[]
  documents      Document[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]
  vendorPackages VendorPackage[]
}

model Contact {
  id         String     @id @default(uuid())
  name       String     // Company name (primary identifier)
  phone      String     @default("N/A")
  email      String     @default("N/A")
  company    String     @default("N/A")
  department String     @default("N/A")
  language   String     @default("English")
  credit     Float      @default(0)
  status     String     @default("Active")
  type       String     @default("Lead")
  assignedTo String?    // User ID of assigned sales person
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // ── Company details ──────────────────────────────
  city           String?
  state          String?
  zip            String?
  country        String?
  address        String?
  companyPhone   String?
  website        String?

  // ── Financial ────────────────────────────────────
  lineOfCredit   Float?   // Credit limit ($)
  openBalance    Float?   // Current outstanding balance ($)
  termDays       Int?     // Payment terms (days, e.g. 30)

  // ── Business profile (stored as JSON arrays) ──────
  classifications Json?   // ["Importer","Receiver","Jobber"]
  commodities     Json?   // ["Citrus","Clementine Mandarin"]

  companyId  String?
  tenant     Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)

  calls      CallLog[]
  notes      Note[]
  shipments  Shipment[]
  orders     Order[]
  users      User[]
  purchaseOrders PurchaseOrder[]
  documents      Document[]
  persons        ContactPerson[]
  vendorPackages VendorPackage[]
  programs       CustomerProgram[]
}

// A customer can run several trading programs over time — e.g. Orange from
// Morocco FOB ends, then Mandarin from Peru CIF starts with the same customer.
model CustomerProgram {
  id         String    @id @default(uuid())
  contactId  String
  product    String    // e.g. "Orange", "Mandarin"
  variety    String?
  origin     String?   // grower's country/region, e.g. "Morocco", "Peru"
  grower     String?   // optional specific grower/supplier name
  incoterm   String?   // FOB | CIF | DDP
  packType   String?   // e.g. "18 KG", "10 KG"
  category   String?   // Cat 1 | Cat 1.5 | Cat 2
  startWeek  Int?      // Week number the program starts (1-53)
  totalWeeks Int?      // Program duration in weeks
  containersPerWeek Int? // Planned containers per week
  status     String    @default("Active") // Active | Completed
  startDate  DateTime?
  endDate    DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model ContactPerson {
  id          String   @id @default(uuid())
  contactId   String
  name        String   // full name (auto: firstName + lastName)
  firstName   String?
  lastName    String?
  title       String?
  email       String?
  phone       String?
  linkedinUrl String?
  createdAt   DateTime @default(now())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(uuid())
  text      String
  isSystem  Boolean  @default(false)
  contactId String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model CallLog {
  id          String   @id @default(uuid())
  blandCallId String?
  status      String
  duration    Int?
  transcript  String?
  summary     String?
  contactId   String
  createdAt   DateTime @default(now())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Shipment {
  id              String    @id @default(uuid())
  label           String
  referenceId     String?   // Manual ref ID (used when no order is linked)
  soNumber        String?   // SO number (Business Central)
  destination     String
  vesselName      String?
  containerNumber String?
  bolNumber       String?
  vesselEta       DateTime?
  vesselDeparture DateTime?
  vesselArrival   DateTime?
  shippingLine    String?
  status          String    @default("Pending")
  notes           String?
  contactId       String
  orderId         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  origin          String?

  // ── Port details ────────────────────────────────
  portOfLoading       String?   // e.g. "Port of Agadir"
  portOfDischarge     String?   // e.g. "Port of Rotterdam"
  transshipmentPort   String?   // e.g. "Port of Algeciras"

  // ── Container & cargo ────────────────────────────
  containerType    String?   // "20RF" | "40RF" | "40HC-RF" | "20DRY" | "40DRY"
  sealNumber       String?
  cargoDescription String?   // e.g. "Citrus - Clementines - Morocco"
  grossWeight      Float?    // kg
  numberOfBoxes    Int?
  pallets          Int?      // Number of pallets
  packType         String?   // Summary, e.g. "15 KG + 16 KG" — auto-derived from packBreakdown
  packBreakdown    String?   // JSON array of {packType, boxQty} — a container can mix weights
  product          String?   // e.g. "Mandarin", "Orange"
  variety          String?   // e.g. "NADORCOTT", "MAROC LATE"
  grower           String?   // Grower / supplier name

  // ── Payment ──────────────────────────────────────
  advancePaymentStatus String? // Pending | Requested | Paid | Not Required

  // ── Reference ────────────────────────────────────
  shipmentRefId    String?   // Manual ref ID when no order is linked

  // ── Logistics extra fields ───────────────────────
  transport        String?   // SEA | AIR | ROAD
  countryOfOrigin  String?   // COO (e.g. Morocco)
  oceanFreight     Float?    // Ocean freight cost
  advToGrower      Float?    // Advance payment to grower
  qcArrival        String?   // QC score at arrival (e.g. "92", "A")
  category         String?   // Quality category — Cat 1 | Cat 1.5 | Cat 2
  gateInEmptyDate  DateTime? // ATA — Gate-in Empty Date (empty container arrival at origin)

  // ── Reefer settings ──────────────────────────────
  reeferTempSet    Float?    // Target temperature °C  (e.g. 6.0)
  reeferTempActual Float?    // Last recorded actual °C
  humidity         Float?    // Relative humidity %    (e.g. 85)
  ventilation      Float?    // Ventilation setting cbm/h (e.g. 25)
  co2Level         Float?    // CO2 % (optional, controlled atmosphere)

  // ── Demurrage & Detention ────────────────────────
  poNumber              String?    // Purchase Order number
  isfSentDate           DateTime?  // Date ISF filing was sent to Customs
  demurrageLastFreeDay  DateTime?  // Last free day at port (demurrage)
  detentionLastFreeDay  DateTime?  // Last free day at customer (per diem/detention)
  emptyReturnDate       DateTime?  // Actual date empty container was returned
  containerReleased     Boolean   @default(false)  // Manually marked released by admin/logistics

  companyId        String?
  company          Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contact          Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  order            Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  documents        Document[]
  events           ShipmentEvent[]
  expenses         ShipmentExpense[]
  activities       ShipmentActivity[]
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ShipmentExpense {
  id            String   @id @default(uuid())
  shipmentId    String
  type          String   // Tariff | Customs | TerminalExamFee | PurchaseOfGoods | USDAExamFee | Revenue | Other
  description   String?
  amount        Float    @default(0)
  boxQuantity   Int?
  boxPrice      Float?
  tariffPercent Float?   @default(10)
  invoiceNumber String?
  isRevenue     Boolean  @default(false)
  createdAt     DateTime @default(now())
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model ShipmentEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  eventType   String
  // Pre-Cooling | Stuffing | Gate In | Customs Cleared | Vessel Departed |
  // Transshipment Arrived | Transshipment Departed | Vessel Arrived |
  // Customs Destination | Out for Delivery | Delivered
  location    String
  description String?
  eventDate   DateTime
  tempReading Float?   // Optional temperature recorded at this milestone (°C)
  createdAt   DateTime @default(now())
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model ShipmentActivity {
  id         String   @id @default(uuid())
  shipmentId String
  userName   String
  action     String
  detail     String?
  createdAt  DateTime @default(now())
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("user")
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String   @id @default(uuid())
  referenceId   String   @unique
  grower        String?
  shipper       String?
  product       String
  label         String?
  variety       String
  boxType       String?
  boxQuantity   Int
  purchasePrice Float?
  salePrice     Float?
  expense       Float?
  receiver      String?
  week          String?
  departureWeek Int?
  arrivalWeek   Int?
  status        String   @default("pending")
  advancePaymentTerms  Int?
  advancePaymentPct    Float?
  advancePaymentAmount Float?
  note          String?
  departurePort String?
  arrivalPort   String?
  oceanFreight  Float?    // $/box ocean freight in offer (legacy)
  incoterm      String?   // FOB | CIF | DDP — price basis of the offer
  paymentTerms  String?   // e.g. "100% UPFRONT"
  producer      String?   // producing company on the offer
  quality       String?   // e.g. "CAT 1"
  sizes         String?   // e.g. "100s 50% AND 113s 50%"
  fclCount      Int?      // number of containers offered
  fclBoxes      Int?      // boxes per FCL
  createdBy     String?   // username who entered the offer/order
  userId        String?
  contactId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  companyId     String?
  tenant       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  user          User?    @relation(fields: [userId], references: [id])
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  invoices      Invoice[]
  documents     Document[]
  shipments     Shipment[]
  activities    OrderActivity[]
}

model OrderActivity {
  id        String   @id @default(uuid())
  orderId   String
  userName  String
  action    String
  detail    String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PortLocation {
  id        String   @id @default(uuid())
  name      String
  companyId String?
  createdAt DateTime @default(now())
}

// Trucking carriers and ocean shipping lines — one directory, distinguished by type
model Carrier {
  id          String   @id @default(uuid())
  name        String
  type        String   // "Trucking" | "Shipping Line"
  scacCode    String?  // Standard Carrier Alpha Code, e.g. "MAEU"
  contactName String?
  phone       String?
  email       String?
  notes       String?
  status      String   @default("Active") // Active | Inactive
  companyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  documents   Document[]
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  poNumber    String   @unique
  orderId     String
  supplierId  String
  totalAmount Float    @default(0)
  status      String   @default("Draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String?
  tenant     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  order       Order    @relation(fields: [orderId], references: [id])
  supplier    Contact  @relation(fields: [supplierId], references: [id])
  invoices    Invoice[]
  documents   Document[]
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  type          String    // "Sales" or "Purchase"
  amount        Float
  status        String    @default("Unpaid") // Unpaid | Partial | Paid
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  notes         String?
  orderId       String?
  poId          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  companyId     String?
  tenant       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  order         Order?    @relation(fields: [orderId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id])
  payments      Payment[]
  documents     Document[]
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  amount      Float
  method      String   @default("Bank Transfer") // Bank Transfer | Cash | Check | Card | Other
  reference   String?
  notes       String?
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Document {
  id          String   @id @default(uuid())
  name        String
  originalName String
  mimeType    String
  size        Int
  path        String
  category    String   @default("General") // BOL | Phytosanitary | Invoice | Certificate | General
  companyId   String?
  contactId   String?
  orderId     String?
  shipmentId  String?
  invoiceId   String?
  poId        String?
  carrierId   String?
  uploadedBy  String?
  createdAt   DateTime @default(now())
  tenant     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shipment    Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  carrier     Carrier?  @relation(fields: [carrierId], references: [id], onDelete: SetNull)
}

model VendorPackage {
  id          String   @id @default(uuid())
  growerId    String
  product     String
  variety     String
  boxType     String?
  size        String?
  quantity    Int
  pricePerBox Float?
  week        Int?
  season      String?
  notes       String?
  status      String   @default("Available")  // Available | Confirmed | Shipped
  companyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grower    Contact  @relation(fields: [growerId], references: [id], onDelete: Cascade)
  tenant    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
}
