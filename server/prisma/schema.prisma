generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id         String     @id @default(uuid())
  name       String
  phone      String
  email      String     @default("N/A")
  company    String     @default("N/A")
  department String     @default("N/A")
  language   String     @default("English")
  credit     Float      @default(0)
  status     String     @default("Pending")
  type       String     @default("Lead")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  calls      CallLog[]
  notes      Note[]
  shipments  Shipment[]
}

model Note {
  id        String   @id @default(uuid())
  text      String
  isSystem  Boolean  @default(false)
  contactId String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model CallLog {
  id          String   @id @default(uuid())
  blandCallId String?
  status      String
  duration    Int?
  transcript  String?
  summary     String?
  contactId   String
  createdAt   DateTime @default(now())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Shipment {
  id              String    @id @default(uuid())
  label           String
  destination     String
  vesselName      String?
  containerNumber String?
  bolNumber       String?
  vesselEta       DateTime?
  vesselDeparture DateTime?
  vesselArrival   DateTime?
  shippingLine    String?
  status          String    @default("Pending")
  notes           String?
  contactId       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  origin          String?
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
}
