generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  color     String   @default("#ff6b00")
  createdAt DateTime @default(now())

  contacts      Contact[]
  orders        Order[]
  shipments     Shipment[]
  documents     Document[]
  invoices      Invoice[]
  purchaseOrders PurchaseOrder[]
}

model Contact {
  id         String     @id @default(uuid())
  name       String     // Company name (primary identifier)
  phone      String     @default("N/A")
  email      String     @default("N/A")
  company    String     @default("N/A")
  department String     @default("N/A")
  language   String     @default("English")
  credit     Float      @default(0)
  status     String     @default("Active")
  type       String     @default("Lead")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // ── Company details ──────────────────────────────
  city           String?
  state          String?
  zip            String?
  country        String?
  address        String?
  companyPhone   String?
  website        String?

  // ── Business profile (stored as JSON arrays) ──────
  classifications Json?   // ["Importer","Receiver","Jobber"]
  commodities     Json?   // ["Citrus","Clementine Mandarin"]

  companyId  String?
  company    Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)

  calls      CallLog[]
  notes      Note[]
  shipments  Shipment[]
  orders     Order[]
  users      User[]
  purchaseOrders PurchaseOrder[]
  documents      Document[]
  persons    ContactPerson[]
}

model ContactPerson {
  id          String   @id @default(uuid())
  contactId   String
  name        String   // full name (auto: firstName + lastName)
  firstName   String?
  lastName    String?
  title       String?
  email       String?
  phone       String?
  linkedinUrl String?
  createdAt   DateTime @default(now())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(uuid())
  text      String
  isSystem  Boolean  @default(false)
  contactId String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model CallLog {
  id          String   @id @default(uuid())
  blandCallId String?
  status      String
  duration    Int?
  transcript  String?
  summary     String?
  contactId   String
  createdAt   DateTime @default(now())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Shipment {
  id              String    @id @default(uuid())
  label           String
  destination     String
  vesselName      String?
  containerNumber String?
  bolNumber       String?
  vesselEta       DateTime?
  vesselDeparture DateTime?
  vesselArrival   DateTime?
  shippingLine    String?
  status          String    @default("Pending")
  notes           String?
  contactId       String
  orderId         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  origin          String?

  // ── Port details ────────────────────────────────
  portOfLoading       String?   // e.g. "Port of Agadir"
  portOfDischarge     String?   // e.g. "Port of Rotterdam"
  transshipmentPort   String?   // e.g. "Port of Algeciras"

  // ── Container & cargo ────────────────────────────
  containerType    String?   // "20RF" | "40RF" | "40HC-RF" | "20DRY" | "40DRY"
  sealNumber       String?
  cargoDescription String?   // e.g. "Citrus - Clementines - Morocco"
  grossWeight      Float?    // kg
  numberOfBoxes    Int?
  pallets          Int?      // Number of pallets
  packType         String?   // e.g. "18 KG", "10 KG"
  variety          String?   // e.g. "NADORCOTT", "MAROC LATE"
  grower           String?   // Grower / supplier name

  // ── Payment ──────────────────────────────────────
  advancePaymentStatus String? // Pending | Requested | Paid | Not Required

  // ── Reefer settings ──────────────────────────────
  reeferTempSet    Float?    // Target temperature °C  (e.g. 6.0)
  reeferTempActual Float?    // Last recorded actual °C
  humidity         Float?    // Relative humidity %    (e.g. 85)
  ventilation      Float?    // Ventilation setting cbm/h (e.g. 25)
  co2Level         Float?    // CO2 % (optional, controlled atmosphere)

  companyId        String?
  company          Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contact          Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  order            Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  documents        Document[]
  events           ShipmentEvent[]
  expenses         ShipmentExpense[]
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ShipmentExpense {
  id            String   @id @default(uuid())
  shipmentId    String
  type          String   // Tariff | Customs | TerminalExamFee | PurchaseOfGoods | USDAExamFee | Revenue | Other
  description   String?
  amount        Float    @default(0)
  boxQuantity   Int?
  boxPrice      Float?
  tariffPercent Float?   @default(10)
  invoiceNumber String?
  isRevenue     Boolean  @default(false)
  createdAt     DateTime @default(now())
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model ShipmentEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  eventType   String
  // Pre-Cooling | Stuffing | Gate In | Customs Cleared | Vessel Departed |
  // Transshipment Arrived | Transshipment Departed | Vessel Arrived |
  // Customs Destination | Out for Delivery | Delivered
  location    String
  description String?
  eventDate   DateTime
  tempReading Float?   // Optional temperature recorded at this milestone (°C)
  createdAt   DateTime @default(now())
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("user")
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String   @id @default(uuid())
  referenceId   String   @unique
  grower        String?
  shipper       String?
  product       String
  label         String?
  variety       String
  boxType       String?
  boxQuantity   Int
  purchasePrice Float?
  salePrice     Float?
  expense       Float?
  receiver      String?
  week          String?
  status        String   @default("pending")
  userId        String?
  contactId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  user          User?    @relation(fields: [userId], references: [id])
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  invoices      Invoice[]
  documents     Document[]
  shipments     Shipment[]
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  poNumber    String   @unique
  orderId     String
  supplierId  String
  totalAmount Float    @default(0)
  status      String   @default("Draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  order       Order    @relation(fields: [orderId], references: [id])
  supplier    Contact  @relation(fields: [supplierId], references: [id])
  invoices    Invoice[]
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  type          String    // "Sales" or "Purchase"
  amount        Float
  status        String    @default("Unpaid") // Unpaid | Partial | Paid
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  notes         String?
  orderId       String?
  poId          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  order         Order?    @relation(fields: [orderId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id])
  payments      Payment[]
  documents     Document[]
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  amount      Float
  method      String   @default("Bank Transfer") // Bank Transfer | Cash | Check | Card | Other
  reference   String?
  notes       String?
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Document {
  id          String   @id @default(uuid())
  name        String
  originalName String
  mimeType    String
  size        Int
  path        String
  category    String   @default("General") // BOL | Phytosanitary | Invoice | Certificate | General
  companyId   String?
  contactId   String?
  orderId     String?
  shipmentId  String?
  invoiceId   String?
  uploadedBy  String?
  createdAt   DateTime @default(now())
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shipment    Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}
